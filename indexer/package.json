{
  "name": "astera-indexer",
  "version": "2.0.0",
  "description": "Astera Soroban Event Indexer",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:sqlite-to-postgres": "ts-node scripts/migrate-sqlite-to-postgres.ts",
    "test": "ts-node src/db.test.ts src/parser.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "prom-client": "^15.1.2",
    "stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
